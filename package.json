{
  "name": "fidan-dev",
  "version": "1.0.0",
  "private": true,
  "author": {
    "name": "Kaan G\u00f6n\u00fcldinc",
    "email": "contact@appsolves.dev",
    "url": "https://appsolves.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fidan-lang/fidan.dev.git"
  },
  "homepage": "https://fidan.dev",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "prebuild": "npm run sync-legal",
    "sync-legal": "node -e \"const fs=require('fs'); for (const name of ['LICENSE','NOTICE']) fs.copyFileSync(name, 'static/'+name+'.txt');\"",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "e2e:serve": "vite preview --host localhost --port 4174 --strictPort",
    "format:all": "npm exec -- prettier --write .",
    "format:all:check": "npm exec -- prettier --check .",
    "prepare": "node ./scripts/install-git-hooks.mjs",
    "docs:check:fidan": "node ./scripts/check-fidan-docs.mjs",
    "check:release-markdown": "node scripts/check-release-markdown.mjs",
    "check:content": "node --test scripts/check-site-security.mjs",
    "docs:check:links": "node scripts/check-documentation.mjs",
    "docs:test": "node --test scripts/check-documentation.test.mjs scripts/check-fidan-docs.test.mjs scripts/verify-doc-dependencies.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^25.5.0",
    "@types/sanitize-html": "^2.16.2",
    "marked": "^17.0.4",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "^0.7.2"
    }
  },
  "dependencies": {
    "sanitize-html": "^2.18.1"
  },
  "license": "Apache-2.0"
}
